rules_version = '2';

// O navegador só lê o próprio perfil. Toda escrita passa pela API, que usa o
// Admin SDK e não é afetada por estas regras. Ver contract/firestore.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
