rules_version = '2';

// The browser can only read its own profile. All writes go through the API.
// The API uses the Admin SDK, so these rules do not apply to it.
// See contract/firestore.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
