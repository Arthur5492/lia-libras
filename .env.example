LIA_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Storage for .npz files: "local" (folder) or "hf" (HF bucket)
LIA_STORAGE=local
LIA_LOCAL_BUCKET=local_bucket
LIA_HF_BUCKET=
HF_TOKEN=

# Collection
LIA_TARGET_PER_SIGN=4
LIA_POSE_RATE_MIN=0.8
LIA_ANY_HAND_RATE_MIN=0.3
LIA_MIN_REFERENCE_COUNT=3
