{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ]
  },
  "include": [
    "src",
    "shared",
    "server",
    "api",
    "tests/server",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
